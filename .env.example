# ============================================================================
# AI QUANT ANALYST - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your API keys
# NEVER commit .env to version control - it's in .gitignore for security
# ============================================================================

# ─── LLM & CrewAI Configuration ────────────────────────────────────────────
# OpenAI API Key (REQUIRED for CrewAI full functionality)
# Get your key from: https://platform.openai.com/api-keys
# Free credits: $5 for new accounts
OPENAI_API_KEY=sk-your-key-here

# Optional: Use local LLM instead of OpenAI
# OPENAI_API_BASE=http://localhost:8000/v1
# OPENAI_MODEL=local-model

# ─── Financial Data APIs ──────────────────────────────────────────────────
# Finnhub API Key (OPTIONAL - enables institutional news and earnings calendar)
# Free tier: 60 requests/minute
# Get your free key from: https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_key_here

# NewsAPI Key (OPTIONAL - enables global news sentiment analysis)
# Free tier: 100 requests/day
# Get your key from: https://newsapi.org/
NEWS_API_KEY=your_newsapi_key_here

# ─── Flask Configuration ───────────────────────────────────────────────────
# Secret key for session management (generate a random string)
# Run: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_super_secret_random_key_here

# Application mode
DEBUG=False                              # Set to True only during development
FLASK_ENV=production                    # development / production

# ─── Application Settings ─────────────────────────────────────────────────
# Upload folder for documents
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=104857600            # 100MB max file size

# Cache settings
CACHE_ENABLED=true
CACHE_TTL=3600                          # Cache time-to-live in seconds

# Analysis timeouts
ANALYSIS_TIMEOUT=120                    # Seconds

# ─── Database Settings (Future) ────────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/quant_analyst
# REDIS_URL=redis://localhost:6379

# ─── Logging Configuration ────────────────────────────────────────────────
LOG_LEVEL=INFO                          # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/app.log

# ============================================================================
# NOTES:
# ✅ All API keys are optional - system has intelligent fallbacks
# ✅ With OPENAI_API_KEY: Full multi-agent AI analysis
# ✅ Without OPENAI_API_KEY: Deterministic analysis pipeline still works
# ✅ Generate SECRET_KEY using: python -c "import secrets; print(secrets.token_hex(32))"
# ============================================================================
# MAX_CONTENT_LENGTH=16777216
